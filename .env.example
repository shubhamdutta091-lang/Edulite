# Copy this file to .env and set a unique secret before deployment.
DATABASE_URL=sqlite:///./edulite.db
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRY_HOURS=24
GEMINI_API_KEY=
# Optional: full path to tesseract.exe if OCR is installed outside the default locations.
TESSERACT_CMD=
# Optional: enable Google Programmable Search for in-app curated resource discovery.
# Enable Custom Search API, then create a Programmable Search Engine for the trusted education sites.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
MAX_UPLOAD_MB=20
RESOURCE_SEARCH_LIMIT=12
